# Optional: published support phone (JSON-LD LocalBusiness / Organization in SEO.tsx)
# E.164 recommended, e.g. +91-22-1234-5678
# VITE_ORG_TELEPHONE=

# Google Analytics 4 — set to your real Measurement ID (e.g. G-ABC123XYZ)
# VITE_GA_MEASUREMENT_ID=

# Optional: Meta Pixel numeric id (if you add a client-side loader later)
# VITE_FACEBOOK_PIXEL_ID=

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# App Configuration
VITE_APP_URL=https://your-netlify-app.netlify.app
VITE_APP_NAME=SpeakCEO - Young Entrepreneurship Program

# Optional: OpenAI Configuration (if using AI features)
VITE_OPENAI_API_KEY=your_openai_api_key_if_needed
